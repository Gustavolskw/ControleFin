# Copie para .env e troque os valores (o ./controlefin.sh start cria um .env com segredos aleatórios).

# --- Banco e autenticação ---
POSTGRES_USER=controlefin
POSTGRES_PASSWORD=troque-esta-senha
# Usuário restrito da aplicação (controlefin_app), sujeito ao Row-Level Security. O backend cria/atualiza.
APP_DB_PASSWORD=troque-esta-outra-senha
# Mínimo de 32 caracteres aleatórios.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-chars
# Segredo entre a api-externa e o backend (mínimo 32 caracteres). Nunca sai da máquina.
INTERNAL_API_SECRET=troque-por-outro-segredo-longo-com-32-chars
# Chave dos backups criptografados. Guarde uma cópia fora do servidor.
BACKUP_ENCRYPTION_KEY=troque-por-uma-chave-longa-e-aleatoria
# Chave dos anexos (prints, PDFs, planilhas) criptografados no disco. Sem ela os anexos não abrem: guarde fora do
# servidor junto com o .env. Mínimo de 32 caracteres.
ATTACHMENTS_KEY=troque-por-uma-chave-longa-e-aleatoria-de-32-chars

# --- Administrador padrão (criado só quando o banco não tem nenhum usuário) ---
# É com ele que se entra a primeira vez e se geram os convites (só o admin convida).
# No primeiro login o sistema exige trocar esta senha e cadastrar as perguntas de segurança.
# Em branco = o backend gera uma senha aleatória e mostra no log (./controlefin.sh logs backend).
DEFAULT_USER=controlefin
DEFAULT_USER_PASSWORD=

# --- Gateway nginx (modo standalone: publica estas portas no host) ---
# Diferentes das do Chama&Essencia (8090/8453) para conviver no mesmo servidor.
HTTP_PORT=8091
HTTPS_PORT=8454
NGINX_SELF_SIGNED_CERT_SUBJECT=/CN=localhost
NGINX_SELF_SIGNED_CERT_SAN=DNS:localhost
# true = redireciona HTTP para HTTPS no próprio nginx.
NGINX_FORCE_HTTPS=false

# Réplicas do backend balanceadas pelo nginx.
BACKEND_REPLICAS=1

# --- Traefik (servidor com Traefik na frente, ex.: VPS Hostinger) ---
# true = usa docker-compose.traefik.yml: o nginx não publica portas e o Traefik encaminha o domínio.
TRAEFIK_ENABLED=false
APP_DOMAIN=controlefin.seudominio.com
TRAEFIK_NETWORK=proxy
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT_HTTPS=websecure
TRAEFIK_ENTRYPOINT_HTTP=web
